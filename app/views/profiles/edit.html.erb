<div class="row">
  <div class="col-sm-8 col-md-6 col-lg-4">
    <h2 class="mb-3">Profile</h2>
    <%= render "devise/shared/error_messages", resource: @user %>
  </div>
</div>

<div class="row">
  <div class="col-sm-8 col-md-6 col-lg-4">
    <%= form_with(model: @user, url: profile_path, method: :patch, local: true) do |f| %>
      <div class="field mb-3">
        <%= f.label :username, class: "form-label" %>
        <%= f.text_field :username, autofocus: true, autocomplete: "nickname", data: { "1p-ignore": true, "lpignore": "true" }, class: "form-control" %>
        <div id="usernameHelpBlock" class="form-text">
          This will be used to identify you publicly.
        </div>
      </div>

      <div class="actions mb-3">
        <%= f.submit "Update", class: "btn btn-primary" %>
      </div>
    <% end %>

    <%= link_to "Change email or password", edit_user_registration_path %>
  </div>
</div>
